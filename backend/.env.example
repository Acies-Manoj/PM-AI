# Copy to .env for local development. Nothing here is required locally: with no AWS
# settings the backend stores sessions as files under backend/data/ and runs with no login.
# (LLM calls always go to Amazon Bedrock, so run `aws configure` / set AWS_PROFILE and make
# sure your AWS user may call bedrock:InvokeModel.)

# --- AWS --------------------------------------------------------------------------------
AWS_REGION=eu-north-1
# Bedrock / Translate can live in another region if Stockholm lacks the model/language.
# BEDROCK_REGION=eu-north-1
# TRANSLATE_REGION=eu-north-1

# --- Storage: set ALL THREE of S3_BUCKET, DDB_SESSIONS, DDB_DOCS to use AWS instead of local files
# S3_BUCKET=pmai-data-<account-id>-eu-north-1
# DDB_SESSIONS=pmai-sessions
# DDB_DOCS=pmai-docs
# DDB_PROFILES=pmai-profiles
# DDB_AUDIT=pmai-audit-log
# SESSION_TTL_DAYS=30
# UPLOAD_MAX_BYTES=209715200

# --- Microsoft Entra ID: set BOTH to require a signed-in user (the API app's ids) ------------
# ENTRA_TENANT_ID=<directory (tenant) id>
# ENTRA_CLIENT_ID=<application (client) id of the pmai-api app registration>

# --- CORS: comma-separated browser origins allowed to call the API ---------------------------
# CORS_ORIGINS=https://<your-branch>.<app-id>.amplifyapp.com
# CORS_ALLOW_LOCALHOST=0

# --- Bedrock models (ids or "eu." inference-profile ids your account can call) -------------
# Copy each model's exact "Model ID" from its card in the Bedrock console (Model catalog).
# BEDROCK_CHEAP_MODEL=openai.gpt-oss-20b-1:0     # prose summaries (audit, overall, report, interpretation)
# BEDROCK_DEFAULT_MODEL=openai.gpt-oss-20b-1:0   # most calls
# BEDROCK_STRONG_MODEL=openai.gpt-oss-20b-1:0    # planner / think calls; try openai.gpt-oss-120b-1:0 if unreliable
# One call only:  MODEL_<CALL_NAME_IN_CAPITALS>=<model id>
# System prompts: not in the code. A deployed backend reads each one from Bedrock Prompt Management;
# list ALL 19 here (python scripts/bedrock_prompts.py create prints this value).
# In a dev checkout, backend/prompts/<call_name>.txt is used for any prompt not listed.
# BEDROCK_PROMPT_IDS={"planner_agent": "PROMPTID:1", "audit_agent": "OTHERID:1"}
# PROMPTS_BEDROCK_ONLY=1   # ignore local prompt files: a prompt missing from Bedrock fails loudly
# LLM_MAX_TOKENS=6000
