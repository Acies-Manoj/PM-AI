# Backend API base URL (default http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Microsoft Entra ID sign-in. Leave BOTH unset to disable auth (local dev).
# Tenant id, and the client id of the SPA app registration ("pmai-web").
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
# The API app registration ("pmai-api"). Set ONE of these when auth is on:
#   VITE_API_SCOPE=api://<pmai-api client id>/access_as_user
#   VITE_ENTRA_API_CLIENT_ID=<pmai-api client id>
VITE_API_SCOPE=
VITE_ENTRA_API_CLIENT_ID=
